# data and caches: never commit microdata or third-party copyrighted PDFs
local_data/
data_raw/
*.csv
*.parquet
*.zip
*.feather
*.arrow
*.parquet.*
*.sas7bdat
*.xpt
*.dbf
*.RData
*.rds
lit/*.pdf
.cache/
# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.coverage
htmlcov/
lit/txt/

# small golden reference tables (aggregated estimates, no microdata) are tracked
!tests/golden/*.csv

# third-party papers under audit (never commit)
some papers/*.pdf

# third-party journal templates (Elsevier SoftwareX), fetched 2026-10-22, sha256 9fcf40ed...b916d; not redistributed
paper/softwarex/template/
# generated manuscript files (contain [[AUTHOR-TODO]] markers until the author fills them)
paper/softwarex/pynhts_softwarex.docx
paper/softwarex/pynhts_softwarex.pdf
paper/softwarex/pynhts_softwarex_latex_sources.zip
paper/softwarex/latex/*.aux
paper/softwarex/latex/*.log
paper/softwarex/latex/*.out
paper/softwarex/latex/*.pdf
paper/softwarex/latex/*.spl
paper/softwarex/literature/abstracts.json

# NHTS Compendium of Uses (FHWA/ORNL): raw editions, the abstract-bearing master workbook and the parse cache stay local;
# checksums are in compendium/SOURCES.md. Numbers-only audit files and the shipped package data are tracked.
compendium/*.pdf
compendium/*.xlsx
compendium/_parsed_cache.pkl
!compendium/extraction_audit.csv
!compendium/tag_precision_review.csv
!compendium/tag_precision_sample.csv
!src/pynhts/_data/*.parquet
!src/pynhts/_data/*.csv
!papers/02-nhts-ladder/results/tables/*.csv

# AI export of the master workbook contains abstracts: local only
compendium/ai_export/
